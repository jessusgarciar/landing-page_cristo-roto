# Copia este archivo a .env y completa la configuración web de Firebase.
# PUBLIC_* se incluye en el navegador: no uses claves privadas ni tokens aquí.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_DATABASE_ID=
