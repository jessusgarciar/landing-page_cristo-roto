---
import type { Service } from '../lib/firebase';
import { serviceIcons } from '../lib/i18n';

interface Props {
  services: Service[];
}

const { services } = Astro.props as Props;
---

<section id="servicios" class="bg-green px-md py-lg md:py-xl">
  <div class="flex items-center gap-sm mb-md">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2">
      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
      <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
    </svg>
    <h2 class="text-[22px] font-bold text-text-primary" data-i18n="servicios_title">Servicios</h2>
  </div>

  <div class="flex flex-col gap-md">
    {services.map((s) => (
      <div
        class="service-card bg-card-white rounded-lg shadow-[0_1px_3px_rgba(0,0,0,0.12)] p-md flex gap-md cursor-pointer transition-all duration-250 hover:-translate-y-[2px] hover:shadow-lg"
        data-name={s.name}
        data-description={s.description}
        data-schedule={s.schedule}
        data-phone={s.phone}
        data-address={s.address || ''}
        data-offers={JSON.stringify(s.offers || [])}
        data-lat={s.latitude?.toString() || ''}
        data-lng={s.longitude?.toString() || ''}
        data-show-offers="false"
      >
        <div class="w-14 h-14 flex-shrink-0 bg-green rounded-md flex items-center justify-center">
          <span class="text-[28px] leading-none">{serviceIcons[s.icon] || 'ℹ️'}</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-bold text-text-primary leading-tight mb-1">{s.name}</h3>
          <p class="text-xs text-text-secondary leading-snug mb-sm">{s.description}</p>
          <p class="text-[11px] text-text-light">{s.schedule}</p>
          {s.phone && (
            <div class="flex items-center gap-1 mt-1">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1976D2" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              <a href={`tel:${s.phone}`} class="text-xs text-phone-blue font-medium no-underline hover:underline" onclick="event.stopPropagation()">{s.phone}</a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
(function() {
  document.querySelectorAll('.service-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var lat = card.getAttribute('data-lat');
      var lng = card.getAttribute('data-lng');
      var coordinates = null;
      if (lat && lng) coordinates = { lat: parseFloat(lat), lng: parseFloat(lng) };
      window.dispatchEvent(new CustomEvent('open-place-popup', {
        detail: {
          name: card.getAttribute('data-name'),
          description: card.getAttribute('data-description'),
          schedule: card.getAttribute('data-schedule'),
          phone: card.getAttribute('data-phone'),
          imagePath: '',
          logoPath: '',
          address: card.getAttribute('data-address'),
          offers: JSON.parse(card.getAttribute('data-offers') || '[]'),
          coordinates: coordinates,
          showOffersTab: false,
        }
      }));
    });
  });
})();
</script>
