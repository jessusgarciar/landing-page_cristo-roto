---
import type { Restaurant } from '../lib/firebase';

interface Props {
  restaurants: Restaurant[];
}

const { restaurants } = Astro.props as Props;
---

<section id="restaurantes" class="px-md py-lg md:py-xl">
  <div class="flex items-center gap-sm mb-md">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8772E" stroke-width="2">
      <path d="M18 8h1a4 4 0 010 8h-1"/>
      <path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/>
      <line x1="6" y1="1" x2="6" y2="4"/>
      <line x1="10" y1="1" x2="10" y2="4"/>
      <line x1="14" y1="1" x2="14" y2="4"/>
    </svg>
    <h2 class="text-[22px] font-bold text-text-primary" data-i18n="restaurantes">Restaurantes</h2>
  </div>

  <div class="flex flex-col gap-md">
    {restaurants.map((r) => (
      <div
        class="restaurant-card bg-card-white rounded-lg shadow-[0_1px_3px_rgba(0,0,0,0.12)] flex overflow-hidden cursor-pointer transition-all duration-250 hover:-translate-y-[2px] hover:shadow-lg"
        data-name={r.name}
        data-description={r.description}
        data-schedule={r.schedule}
        data-phone={r.phone}
        data-image={r.imagePath || ''}
        data-logo={r.logoPath || ''}
        data-address={r.address || ''}
        data-offers={JSON.stringify(r.offers || [])}
        data-lat={r.latitude?.toString() || ''}
        data-lng={r.longitude?.toString() || ''}
      >
        <div class="relative w-[120px] h-[140px] flex-shrink-0 overflow-hidden bg-header-blue/10">
          <img
            src={r.imagePath}
            alt={r.name}
            width="120"
            height="140"
                        style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </div>
        <div class="flex-1 p-md flex flex-col justify-start min-w-0">
          <h3 class="text-base font-bold text-text-primary leading-tight mb-1 truncate">{r.name}</h3>
          <p class="text-xs text-text-secondary leading-snug line-clamp-2 mb-sm">{r.description}</p>
          <div class="flex items-center gap-1 text-xs text-text-secondary mt-auto">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{r.schedule}</span>
          </div>
          {r.phone && (
            <div class="flex items-center gap-1 mt-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1976D2" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              <a href={`tel:${r.phone}`} class="text-xs text-phone-blue font-medium no-underline hover:underline" onclick="event.stopPropagation()">{r.phone}</a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-md w-full bg-header-blue/10 rounded-md p-md text-center">
    <p class="text-sm text-header-blue font-medium m-0" data-i18n="tienes_restaurante">Tienes un restaurante? Contactanos para promocionarte aqui.</p>
  </div>
</section>

<script is:inline>
(function() {
  document.querySelectorAll('.restaurant-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var lat = card.getAttribute('data-lat');
      var lng = card.getAttribute('data-lng');
      var coordinates = null;
      if (lat && lng) coordinates = { lat: parseFloat(lat), lng: parseFloat(lng) };
      window.dispatchEvent(new CustomEvent('open-place-popup', {
        detail: {
          name: card.getAttribute('data-name'),
          description: card.getAttribute('data-description'),
          schedule: card.getAttribute('data-schedule'),
          phone: card.getAttribute('data-phone'),
          imagePath: card.getAttribute('data-image'),
          logoPath: card.getAttribute('data-logo'),
          address: card.getAttribute('data-address'),
          offers: JSON.parse(card.getAttribute('data-offers') || '[]'),
          coordinates: coordinates,
          showOffersTab: true,
        }
      }));
    });
  });
})();
</script>
